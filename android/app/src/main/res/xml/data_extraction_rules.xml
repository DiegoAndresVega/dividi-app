<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia de seguridad y transferencia entre dispositivos (API 31 en adelante).
  Mismo motivo que en backup_rules.xml: los tokens no viajan.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
